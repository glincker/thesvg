{
  "name": "@thesvg/astro",
  "version": "4.0.1",
  "description": "Typed Astro SVG components for all 7,600+ brand icons from thesvg.org",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "thesvg.org",
  "homepage": "https://thesvg.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/glincker/thesvg.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/glincker/thesvg/issues"
  },
  "keywords": [
    "svg",
    "icons",
    "brand",
    "logos",
    "astro",
    "astro-component",
    "components",
    "tree-shakeable",
    "esm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./*": {
      "types": "./dist/*.astro.d.ts",
      "default": "./dist/*.astro"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/build-components.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "astro": ">=3"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
